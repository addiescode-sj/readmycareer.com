{
  "name": "readmycareer.com",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "agents",
    "mcp-skills/*",
    "app"
  ],
  "scripts": {
    "dev": "pnpm --filter app dev",
    "build": "pnpm -r build",
    "eval": "bash eval/run_evals.sh",
    "eval:agents": "bash eval/run_evals.sh --skip-rag",
    "eval:fast": "bash eval/run_evals.sh --skip-rag --skip-llm-judge"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
